---
import { getCollection } from "astro:content";
import Layout from "../../Layout.astro";
import CardGrid from "../../components/CardGrid.astro";
import ContentSection from "../../components/ContentSection.astro";
import { navGroups } from "../../data/navigation";

const postDateFormatter = new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
});

const posts = (await getCollection("writing", ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .map((post) => {
        const dateLabel = postDateFormatter.format(post.data.pubDate);
        const seriesLabel = post.data.series
            ? `${post.data.series}${post.data.seriesOrder ? `, part ${post.data.seriesOrder}` : ""}`
            : undefined;

        return {
            title: post.data.title,
            description: post.data.description,
            href: `/writing/${post.id}/`,
            meta: seriesLabel ? `${dateLabel} - ${seriesLabel}` : dateLabel,
            image: post.data.heroImage,
            tags: post.data.tags,
        };
    });
---

<Layout
    title="The Rambling Journal"
    pageTitle={`Welcome to\nThe Rambling Journal`}
    eyebrow=""
    description="Personal writing, informal style, not overly polished, wide array of topics"
    intro="This is where I write about whatever happens to be occupying my brain at the moment. The goal isn't to be a great writer or an influencer. It's simply to have a place to write about things as they happen, complain a little along the way, and maybe learn something from looking back on it later."
    canonicalPath="/writing/"
    currentPath="/writing/"
    navGroups={navGroups}>
    <ContentSection heading="All my rambling so far">
        <CardGrid
            items={posts}
            variant="link"
            emptyText="No writing has been published yet."
        />
    </ContentSection>
</Layout>
