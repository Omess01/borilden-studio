---
import Layout from "../Layout.astro";
import CardGrid from "../components/CardGrid.astro";
import ContentSection from "../components/ContentSection.astro";
import StatGrid from "../components/StatGrid.astro";
import TaggedWritingSection from "../components/TaggedWritingSection.astro";
import { navGroups } from "../data/navigation";
import { pageWritingTags } from "../data/pageTags";

const services = [
    {
        title: "TrueNAS Scale",
        description: "The home server base for storage and self-hosted experiments.",
        tags: ["Storage", "Server"],
    },
    {
        title: "Docker",
        description: "The deployment layer for services like Immich and future tools.",
        tags: ["Containers"],
    },
    {
        title: "Caddy",
        description: "Reverse proxying and TLS for publishing services cleanly.",
        tags: ["Proxy", "Networking"],
    },
];

const stats = [
    {
        label: "Hosting",
        value: "Self-hosted",
        description: "The website can document the server that serves it.",
    },
    {
        label: "Approach",
        value: "Learning by building",
        description: "Small services first, then better structure over time.",
    },
];
---

<Layout
    title="Current Homelab Setup"
    pageTitle="Current Homelab Setup"
    eyebrow="Homelab"
    description="Current Børilden Studio homelab setup, self-hosted services, Docker, Caddy, and TrueNAS Scale."
    intro="A page for documenting what is running, why it exists, and what still needs improving."
    canonicalPath="/infrastructure/"
    currentPath="/infrastructure/"
    navGroups={navGroups}>
    <ContentSection heading="Current Stack">
        <CardGrid items={services} />
    </ContentSection>

    <ContentSection heading="Notes">
        <StatGrid items={stats} />
    </ContentSection>

    <ContentSection heading="Change Log">
        <div class="status-note">
            Add short entries here whenever you change hardware, networking,
            backups, services, or deployment routines.
        </div>
    </ContentSection>

    <TaggedWritingSection
        tags={pageWritingTags.infrastructure}
        heading="Homelab Notes"
        intro="Published writing tagged with Homelab, Docker, Networking, TrueNAS, or Caddy will show up here."
        emptyText="No homelab notes have been published yet."
    />
</Layout>
