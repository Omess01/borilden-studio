---
import Layout from "../Layout.astro";
import CardGrid from "../components/CardGrid.astro";
import ContentSection from "../components/ContentSection.astro";
import TaggedWritingSection from "../components/TaggedWritingSection.astro";
import { navGroups } from "../data/navigation";
import { pageWritingTags } from "../data/pageTags";

const profiles = [
    {
        title: "Steam",
        description: "Add your Steam profile, favorite games, or screenshots here.",
        href: "#",
        tags: ["Profile"],
    },
    {
        title: "Competitive / Ranked",
        description: "A place for rank history, main games, or current goals.",
        tags: ["Gaming"],
    },
    {
        title: "Favorite Games",
        description: "Use this as a running list or turn each game into its own note later.",
        tags: ["Library"],
    },
];
---

<Layout
    title="Gaming Profiles"
    pageTitle="Gaming Profiles"
    eyebrow="Who Am I?"
    description="Gaming profiles, favorite games, and gaming notes for Ben Børilden."
    intro="A simple page for the gaming side of the site."
    canonicalPath="/gaming/"
    currentPath="/gaming/"
    navGroups={navGroups}>
    <ContentSection heading="Profiles">
        <CardGrid items={profiles} />
    </ContentSection>

    <TaggedWritingSection
        tags={pageWritingTags.gaming}
        heading="Gaming Notes"
        intro="Published writing tagged with Gaming will show up here automatically."
        emptyText="No gaming posts have been published yet."
    />
</Layout>
