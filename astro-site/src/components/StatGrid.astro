---
type StatItem = {
    value: string;
    label: string;
    description?: string;
};

interface Props {
    items: StatItem[];
}

const { items } = Astro.props;
---

<div class="stat-grid">
    {
        items.map((item) => (
            <article class="stat-card">
                <span class="card-meta">{item.label}</span>
                <h3>{item.value}</h3>
                {item.description && <p>{item.description}</p>}
            </article>
        ))
    }
</div>
