---
type CardImage = {
    src: string;
    alt: string;
};

interface Props {
    title?: string;
    description?: string;
    href?: string;
    meta?: string;
    image?: CardImage;
    variant?: "default" | "compact" | "media";
    className?: string;
}

const {
    title,
    description,
    href,
    meta,
    image,
    variant = "default",
    className = "",
} = Astro.props;

const classes = ["ui-card", `ui-card-${variant}`, { "ui-card-link": Boolean(href) }, className];
const hasBody = title || description || meta || Astro.slots.has("default");
---

{
    href ? (
        <a class:list={classes} href={href}>
            {image && <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />}

            {
                hasBody && (
                    <div class="ui-card-body">
                        {meta && <span class="card-meta">{meta}</span>}
                        {title && <h3>{title}</h3>}
                        {description && <p>{description}</p>}
                        <slot />
                    </div>
                )
            }
        </a>
    ) : (
        <article class:list={classes}>
            {image && <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />}

            {
                hasBody && (
                    <div class="ui-card-body">
                        {meta && <span class="card-meta">{meta}</span>}
                        {title && <h3>{title}</h3>}
                        {description && <p>{description}</p>}
                        <slot />
                    </div>
                )
            }
        </article>
    )
}
