---
interface Props {
    image: string;
    alt: string;
    title?: string;
    text?: string;
}

const { image, alt, title, text } = Astro.props;
---

<aside class="hero-panel">
    <img
        src={image}
        alt={alt}
        loading="eager"
        decoding="async"
        fetchpriority="high"
    />

    {
        (title || text) && (
            <div class="hero-panel-body">
                {title && <strong>{title}</strong>}
                {text && <p>{text}</p>}
            </div>
        )
    }
</aside>
