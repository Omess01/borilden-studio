type IconName = keyof typeof iconPaths;

type LinkItem = {
    label: string;
    href: string;
    external?: boolean;
    icon?: IconName;
    iconSrc?: string;
};

type LinkSection = {
    heading: string;
    links: LinkItem[];
};

interface Props {
    sections: LinkSection[];
}

const { sections } = Astro.props;
---

{
    sections.map((section) => (
        <section class="bio-link-section" aria-labelledby={`${section.heading.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-title`}>
            <h2 id={`${section.heading.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-title`}>
                {section.heading}
            </h2>

            <div class="bio-link-list">
                {
                    section.links.map((link) => {
                        const icon = link.icon ? iconPaths[link.icon] : undefined;
                        const hasIcon = Boolean(icon || link.iconSrc);

                        return (
                            <a
                                class:list={["bio-link", { "bio-link-social": hasIcon }]}
                                href={link.href}
                                target={link.external ? "_blank" : undefined}
                                rel={link.external ? "noopener noreferrer" : undefined}>
                                {
                                    icon && (
                                        <span class="bio-link-icon" aria-hidden="true">
                                            <svg
                                                viewBox={icon.viewBox}
                                                fill="currentColor"
                                                focusable="false">
                                                <path d={icon.path} />
                                            </svg>
                                        </span>
                                    )
                                }

                                {
                                    !icon && link.iconSrc && (
                                        <span class="bio-link-icon" aria-hidden="true">
                                            <img
                                                src={link.iconSrc}
                                                alt=""
                                                width="20"
                                                height="20"
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        </span>
                                    )
                                }

                                <span>{link.label}</span>
                            </a>
                        );
                    })
                }
            </div>
        </section>
    ))
}
