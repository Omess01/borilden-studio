---
interface Props {
    title?: string;
    text?: string;
    actionLabel?: string;
    href?: string;
    className?: string;
}

const {
    title = "Nothing here yet",
    text,
    actionLabel,
    href,
    className = "",
} = Astro.props;
---

<div class:list={["ui-empty-state", className]}>
    <h2>{title}</h2>
    {text && <p>{text}</p>}

    {
        actionLabel && href && (
            <a class="ui-button ui-button-secondary" href={href}>
                {actionLabel}
            </a>
        )
    }
</div>
