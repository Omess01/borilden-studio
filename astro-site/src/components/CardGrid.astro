---
type CardItem = {
    title: string;
    description?: string;
    href?: string;
    meta?: string;
    image?: {
        src: string;
        alt: string;
    };
    tags?: string[];
};

interface Props {
    items: CardItem[];
    variant?: "feature" | "link" | "album" | "gallery" | "timeline" | "stat";
    emptyText?: string;
    showTags?: boolean;
}

const {
    items,
    variant = "feature",
    emptyText = "Nothing has been added here yet.",
    showTags = false,
} = Astro.props;

const gridClass = `${variant}-grid`;
const cardClass = `${variant}-card`;
---

{
    items.length > 0 ? (
        <div class={gridClass}>
            {
                items.map((item) =>
                    item.href ? (
                        <a class={cardClass} href={item.href}>
                            {
                                item.image && (
                                    <img
                                        src={item.image.src}
                                        alt={item.image.alt}
                                        loading="lazy"
                                        decoding="async"
                                    />
                                )
                            }

                            <div class:list={[`${variant}-card-body`, { "card-body": !item.image }]}>
                                {item.meta && <span class="card-meta">{item.meta}</span>}
                                <h3>{item.title}</h3>
                                {item.description && <p>{item.description}</p>}

                                {
                                    showTags && item.tags && item.tags.length > 0 && (
                                        <div class="tag-list">
                                            {item.tags.map((tag) => <span>{tag}</span>)}
                                        </div>
                                    )
                                }
                            </div>
                        </a>
                    ) : (
                        <article class={cardClass}>
                            {
                                item.image && (
                                    <img
                                        src={item.image.src}
                                        alt={item.image.alt}
                                        loading="lazy"
                                        decoding="async"
                                    />
                                )
                            }

                            <div class:list={[`${variant}-card-body`, { "card-body": !item.image }]}>
                                {item.meta && <span class="card-meta">{item.meta}</span>}
                                <h3>{item.title}</h3>
                                {item.description && <p>{item.description}</p>}

                                {
                                    showTags && item.tags && item.tags.length > 0 && (
                                        <div class="tag-list">
                                            {item.tags.map((tag) => <span>{tag}</span>)}
                                        </div>
                                    )
                                }
                            </div>
                        </article>
                    )
                )
            }
        </div>
    ) : (
        <p class="empty-state">{emptyText}</p>
    )
}
