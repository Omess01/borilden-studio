---
interface Props {
    heading?: string;
    intro?: string;
    id?: string;
    className?: string;
}

const { heading, intro, id, className = "" } = Astro.props;

const headingId =
    id ??
    heading
        ?.toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/(^-|-$)/g, "");
---

<section
    class:list={["page-section", className]}
    aria-labelledby={heading && headingId ? headingId : undefined}>
    {heading && headingId && <h2 id={headingId}>{heading}</h2>}
    {intro && <p class="section-intro">{intro}</p>}

    <slot />
</section>
