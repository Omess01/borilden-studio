---
import Layout from "../Layout.astro";
import CardGrid from "../components/CardGrid.astro";
import ContentSection from "../components/ContentSection.astro";
import HeroPanel from "../components/HeroPanel.astro";
import { featuredProjects, interests } from "../data/home";
import { navGroups } from "../data/navigation";
import { site } from "../data/site";
---

<Layout
    title={site.name}
    pageTitle={site.name}
    eyebrow="Hello World"
    description={site.description}
    intro="My name is Ben Børilden. I hold a Master's degree in chemistry from NMBU and currently work as a Process Engineer at GE HealthCare. Børilden Studio is my place for photography, homelab experiments, projects, and notes while I learn my way around web development."
    canonicalPath="/"
    currentPath="/"
    navGroups={navGroups}
    showCredit>
    <HeroPanel
        slot="heroPanel"
        image={site.portrait}
        alt="Ben Børilden"
        title="Ben Børilden"
        text="Chemistry, photography, computers, gaming, and the occasional overambitious website idea."
    />

    <a slot="actions" class="button-link button-link-primary" href="/links/">
        Links
    </a>

    <a slot="actions" class="button-link button-link-secondary" href="/portfolio/">
        View Portfolio
    </a>

    <ContentSection
        heading="My Main Interests"
        intro="The main lanes this site is slowly growing into.">
        <CardGrid items={interests} />
    </ContentSection>

    <ContentSection
        heading="Featured Projects"
        intro="A few active or future ideas that can become full Astro pages as they grow.">
        <CardGrid items={featuredProjects} />
    </ContentSection>
</Layout>
