---
import Layout from "../Layout.astro";
import ContentSection from "../components/ContentSection.astro";
import TaggedWritingSection from "../components/TaggedWritingSection.astro";
import { navGroups } from "../data/navigation";
---

<Layout
    title="New Page"
    pageTitle="New Page"
    eyebrow="Template"
    description="Replace this with the page description."
    intro="Replace this with a short page introduction."
    canonicalPath="/new-page/"
    currentPath="/new-page/"
    navGroups={navGroups}>
    <ContentSection heading="First Section">
        <div class="content-prose">
            <p>
                Start writing here. Use this file as a copy-and-rename template
                for static pages that do not need a Markdown collection yet.
            </p>
        </div>
    </ContentSection>

    <TaggedWritingSection
        tags={["Template"]}
        heading="Related Writing"
        intro="Change the tags here to pull matching published writing onto this page."
        emptyText="No related posts have been published yet."
    />
</Layout>
