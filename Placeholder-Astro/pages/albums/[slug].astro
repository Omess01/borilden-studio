---
import { getCollection, render } from "astro:content";
import Layout from "../../Layout.astro";
import CardGrid from "../../components/CardGrid.astro";
import PageFooterNav from "../../components/PageFooterNav.astro";
import TaggedWritingSection from "../../components/TaggedWritingSection.astro";
import { navGroups } from "../../data/navigation";
import { pageWritingTags } from "../../data/pageTags";

export async function getStaticPaths() {
    const albums = await getCollection("albums");

    return albums.map((album) => ({
        params: { slug: album.id },
        props: { album },
    }));
}

const { album } = Astro.props;
const { Content } = await render(album);

const photos = album.data.photos.map((photo) => ({
    title: photo.caption ?? album.data.title,
    image: photo,
}));
---

<Layout
    title={album.data.title}
    pageTitle={album.data.title}
    eyebrow="Album"
    description={album.data.description}
    intro={album.data.description}
    canonicalPath={`/albums/${album.id}/`}
    currentPath="/albums/"
    navGroups={navGroups}>
    <aside slot="heroPanel" class="hero-panel">
        <img
            src={album.data.cover.src}
            alt={album.data.cover.alt}
            loading="eager"
            decoding="async"
        />
        <div class="hero-panel-body">
            {album.data.location && <strong>{album.data.location}</strong>}
            {album.data.cover.caption && <p>{album.data.cover.caption}</p>}
        </div>
    </aside>

    <article class="content-prose">
        <div class="content-meta">
            {album.data.location && <span class="card-meta">{album.data.location}</span>}
            {album.data.tags.map((tag) => <span class="card-meta">{tag}</span>)}
        </div>

        <Content />
    </article>

    <section class="page-section" aria-labelledby="photos-title">
        <h2 id="photos-title">Photos</h2>

        <CardGrid
            items={photos}
            variant="gallery"
            emptyText="No photos have been added to this album yet."
        />
    </section>

    <TaggedWritingSection
        tags={[...pageWritingTags.albums, ...album.data.tags]}
        heading="Related Writing"
        intro="Published writing with matching album or photography tags will show up here."
        emptyText="No related album writing has been published yet."
    />

    <PageFooterNav links={[{ label: "Back to Albums", href: "/albums/" }]} />
</Layout>
