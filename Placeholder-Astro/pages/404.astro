---
import Layout from "../Layout.astro";
---

<Layout
    title="Page Not Found"
    pageTitle="Page Not Found"
    eyebrow="404"
    description="The requested Børilden Studio page could not be found."
    intro="This page does not exist yet, or it moved while the studio was being rearranged."
    showHeader={false}
    canonicalPath="/404/">
    <a slot="actions" class="button-link button-link-primary" href="/">
        Go Home
    </a>

    <a slot="actions" class="button-link button-link-secondary" href="/links/">
        Links
    </a>
</Layout>
