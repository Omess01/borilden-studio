---
import { getCollection } from "astro:content";
import CardGrid from "./CardGrid.astro";
import ContentSection from "./ContentSection.astro";

interface Props {
    tags: string[];
    heading?: string;
    intro?: string;
    emptyText?: string;
    limit?: number;
    excludeId?: string;
    showWhenEmpty?: boolean;
}

const {
    tags,
    heading = "Related Writing",
    intro = "Published writing with matching tags will show up here automatically.",
    emptyText = "No related posts have been published yet.",
    limit,
    excludeId,
    showWhenEmpty = true,
} = Astro.props;

const normalizedTags = tags.map((tag) => tag.toLowerCase());

const postDateFormatter = new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
});

const posts = (await getCollection("writing", ({ id, data }) => {
    const hasMatchingTag = data.tags.some((tag) =>
        normalizedTags.includes(tag.toLowerCase())
    );

    return !data.draft && id !== excludeId && hasMatchingTag;
}))
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, limit)
    .map((post) => ({
        title: post.data.title,
        description: post.data.description,
        href: `/writing/${post.id}/`,
        meta: postDateFormatter.format(post.data.pubDate),
        image: post.data.heroImage,
        tags: post.data.tags,
    }));
---

{
    (posts.length > 0 || showWhenEmpty) && (
        <ContentSection heading={heading} intro={intro}>
            <CardGrid items={posts} variant="link" emptyText={emptyText} />
        </ContentSection>
    )
}
