---
type FooterLink = {
    label: string;
    href: string;
};

interface Props {
    links: FooterLink[];
}

const { links } = Astro.props;
---

<nav class="page-footer-nav" aria-label="Related pages">
    {
        links.map((link) => (
            <a class="button-link button-link-secondary" href={link.href}>
                {link.label}
            </a>
        ))
    }
</nav>
