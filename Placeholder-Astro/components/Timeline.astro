---
type TimelineItem = {
    title: string;
    description?: string;
    date?: string;
    href?: string;
    tags?: string[];
};

interface Props {
    items: TimelineItem[];
}

const { items } = Astro.props;
---

<div class="timeline-grid">
    {
        items.map((item) =>
            item.href ? (
                <a class="timeline-card" href={item.href}>
                    {item.date && <span class="card-meta">{item.date}</span>}
                    <h3>{item.title}</h3>
                    {item.description && <p>{item.description}</p>}

                    {
                        item.tags && item.tags.length > 0 && (
                            <div class="tag-list">
                                {item.tags.map((tag) => <span>{tag}</span>)}
                            </div>
                        )
                    }
                </a>
            ) : (
                <article class="timeline-card">
                    {item.date && <span class="card-meta">{item.date}</span>}
                    <h3>{item.title}</h3>
                    {item.description && <p>{item.description}</p>}

                    {
                        item.tags && item.tags.length > 0 && (
                            <div class="tag-list">
                                {item.tags.map((tag) => <span>{tag}</span>)}
                            </div>
                        )
                    }
                </article>
            )
        )
    }
</div>
